# Postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nepse
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset_pass

# Scraper
# News portal scraping cadence (news-service). Also happens to divide NPT's
# 5h45m UTC offset evenly at its default, so it needs no NPT-alignment
# offset (see news-service/register_schedules.py's _npt_aligned_offset).
SCRAPER_INTERVAL_MINUTES=15
# NEPSE market-data scraping cadence (nepse-service): live index scrape,
# gated the same way as before by LIVE_NEPSE_SCRAPE_ENABLED below. The 4
# newer nepalstock.com.np endpoint scrapes (today-price, floor sheet,
# sector summary, market depth) run on their own fixed 1-minute schedules,
# independent of this value.
NEPSE_SCRAPER_INTERVAL_MINUTES=1
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_MAX_ARTICLES_PER_PORTAL=20
LIVE_NEPSE_SCRAPE_ENABLED=false
HISTORICAL_DAILY_ENABLED=true
HISTORICAL_START_DATE=2020-01-01
HISTORICAL_DAILY_HOUR_NPT=2
HISTORICAL_DAILY_MINUTE_NPT=30
HISTORICAL_REQUEST_TIMEOUT=20
HISTORICAL_MAX_RECORDS_PER_PORTAL_PER_DAY=50
HISTORICAL_NEPSE_CSV_IMPORT_ON_STARTUP=true
HISTORICAL_NEPSE_CSV_DIR=/app/historical-data
HISTORICAL_BACKFILL_ON_STARTUP=true

# Historical NEWS backfill (2021-01-01 to 2026-06-29), separate from the
# GDELT-backed HISTORICAL_DAILY_* settings above -- discovers old articles
# via sitemap/cursor crawling for karobardaily, myrepublica, sharesansar
# and fetches them at ~1 request/minute per portal via dedicated Temporal
# schedules (see register_schedules.py). Off by default.
HISTORICAL_NEWS_BACKFILL_ENABLED=false

# One-time cleanup pass over EXISTING nepse_news rows missing published_at
# and/or body -- refetches each row's own url and fills in whatever's
# missing (BS->AD conversion where needed). Independent of
# HISTORICAL_NEWS_BACKFILL_ENABLED above (that discovers NEW old articles;
# this fixes gaps in articles already in the table). Off by default.
NEPSE_NEWS_FIELDS_BACKFILL_ENABLED=false

# Market-depth rotation (nepse-service): the MARKET_DEPTH_TOP_N most liquid
# securities (by latest daily turnover) are walked MARKET_DEPTH_BATCH_SIZE
# per 1-minute tick -> each refreshed every ceil(N / batch) minutes.
# MARKET_DEPTH_TOP_N=0 walks all ~650 listed securities.
MARKET_DEPTH_TOP_N=50
MARKET_DEPTH_BATCH_SIZE=25

# Research datasets (nepse-service): deep daily OHLCV for all 17 indices and
# every equity (nepse_index_daily / nepse_stock_daily) and ~1-minute intraday
# ticks (nepse_intraday_tick) from merolagani.com, refreshed weekly (Saturday
# 06:00 NPT) and on worker startup; official end-of-day bars are captured
# every trading day at 15:40 NPT. See CLAUDE.md "Research datasets".
RESEARCH_BACKFILL_ENABLED=true
RESEARCH_BACKFILL_ON_STARTUP=true
# How far back the intraday tick backfill walks (merolagani has data from ~2018).
INTRADAY_BACKFILL_START_DATE=2018-01-01
INTRADAY_BACKFILL_INDICES=true
# Per-stock intraday ticks: "" = none, "ALL" = every active equity (tens of
# millions of rows), or a comma-separated list, e.g. NABIL,NICA,UPPER.
INTRADAY_BACKFILL_STOCKS=
MEROLAGANI_REQUEST_PAUSE_SECONDS=2
# Past floor sheets (broker ids on every trade + trades the intraday scrape
# missed) are completed from merolagani from this session on, weekly
# (Sunday 06:00 NPT) and on worker startup. merolagani has data back to
# ~2020 -- an earlier date pulls broker-level history around past crashes
# (2020+ is ~100M trades: ~8-9 days of paced requests and ~25-30 GB).
FLOORSHEET_BACKFILL_START_DATE=2026-09-15

# API
PORT=8001

# Auth (admin accounts live in the admin_users table -- create one with:
#   docker compose exec api-service python manage.py create-admin)
JWT_SECRET=dev-only-nepse-jwt-secret-change-me
JWT_TTL_MINUTES=480
COOKIE_SECURE=false

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
